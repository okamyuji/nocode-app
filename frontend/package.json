{
  "name": "nocode-app-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "oxlint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt \"src/**/*.{ts,tsx,css,json}\" pnpm-workspace.yaml",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css,json}\" pnpm-workspace.yaml",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "ci": "pnpm run check && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "markdownlint-cli": "^0.49.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
