# @vitest/* pin exact-version peers on vitest; bumping vitest alone (PR #26) only warned and left the family out of step.
# Fail resolving installs (`pnpm install` / `pnpm add`) on unmet peers instead.
# pnpm 10.24 does not apply this to `pnpm update`, and --frozen-lockfile never re-evaluates peers.
strict-peer-dependencies=true
